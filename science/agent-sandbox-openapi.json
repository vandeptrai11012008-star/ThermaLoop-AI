{
  "openapi": "3.1.0",
  "info": {
    "title": "ThermaLoop Remote Agent Simulation API",
    "version": "1.2.0",
    "description": "Uncalibrated reduced-order simulation. Passing these checks is not authorization or evidence of safety for real building control. The hosted API is a separate Node service, not the Render Static Site. Never embed a Bearer token in browser code."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local default; replace with the separately deployed HTTPS API hostname"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Unauthenticated liveness check",
        "security": [],
        "responses": {
          "200": {
            "description": "API process running; not a physics-validation result"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getAgentApiHealth",
        "summary": "Authenticated API status",
        "responses": {
          "200": {
            "description": "API and engine versions"
          }
        }
      }
    },
    "/api/v1/schema": {
      "get": {
        "operationId": "getAgentSchema",
        "summary": "Simulation controls and bounds",
        "responses": {
          "200": {
            "description": "Control schema"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getAgentOpenApi",
        "summary": "This machine-readable contract",
        "responses": {
          "200": {
            "description": "OpenAPI schema"
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getAgentQuota",
        "summary": "Current token quota and session usage",
        "responses": {
          "200": {
            "description": "Per-principal quotas and usage"
          },
          "429": {
            "description": "Request quota reached"
          }
        }
      }
    },
    "/api/v1/simulations/evaluate": {
      "post": {
        "operationId": "evaluateBuildingControlPlan",
        "summary": "Simulate a proposed control plan against paired baselines",
        "description": "No hardware action occurs. Body must be at most 64 KiB. Same engine as the browser workspace.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schemaVersion": {
                    "type": "integer",
                    "const": 1
                  },
                  "scenario": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "preset": {
                        "type": "string",
                        "enum": [
                          "winter",
                          "burst",
                          "summer",
                          "pump-fault"
                        ]
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "horizonMinutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 360
                      },
                      "outsideC": {
                        "type": "number",
                        "minimum": -20,
                        "maximum": 40
                      },
                      "loadFraction": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "occupants": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 200
                      },
                      "solarKW": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 30
                      },
                      "initialState": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "gpuC": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 120
                          },
                          "coolantC": {
                            "type": "number",
                            "minimum": 5,
                            "maximum": 70
                          },
                          "buildingC": {
                            "type": "number",
                            "minimum": 5,
                            "maximum": 40
                          }
                        }
                      }
                    }
                  },
                  "plan": {
                    "type": "array",
                    "maxItems": 50,
                    "description": "Increasing unique minute offsets, each less than horizonMinutes. Empty array preserves baseline. Omitted plan uses the example candidate.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "atMinute",
                        "controls"
                      ],
                      "properties": {
                        "atMinute": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 359
                        },
                        "controls": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "gpuPowerLimitPct": {
                              "type": "number",
                              "minimum": 40,
                              "maximum": 100
                            },
                            "pumpPct": {
                              "type": "number",
                              "minimum": 20,
                              "maximum": 100
                            },
                            "fanPct": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "heatRecoveryPct": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "heatingSetpointC": {
                              "type": "number",
                              "minimum": 16,
                              "maximum": 25
                            },
                            "ventilationACH": {
                              "type": "number",
                              "minimum": 0.2,
                              "maximum": 3
                            },
                            "lightingPct": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "schemaVersion": 1,
                "scenario": {
                  "preset": "winter",
                  "seed": 42,
                  "horizonMinutes": 120
                },
                "plan": [
                  {
                    "atMinute": 0,
                    "controls": {
                      "pumpPct": 60,
                      "fanPct": 55,
                      "heatRecoveryPct": 90,
                      "heatingSetpointC": 20.5
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulation report, not a deployment approval",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schemaVersion",
                    "engineVersion",
                    "mode",
                    "request",
                    "baseline",
                    "candidate",
                    "stressTests",
                    "verdict",
                    "limitations"
                  ],
                  "properties": {
                    "mode": {
                      "const": "simulation-only"
                    },
                    "verdict": {
                      "type": "object",
                      "required": [
                        "status",
                        "hardwareAuthorized"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "within_tested_envelope",
                            "needs_revision"
                          ]
                        },
                        "hardwareAuthorized": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, scenario or action"
          },
          "401": {
            "description": "API token missing or incorrect when configured"
          },
          "403": {
            "description": "Cross-origin request refused"
          },
          "413": {
            "description": "Request exceeds 64 KiB"
          },
          "415": {
            "description": "JSON content type required"
          },
          "429": {
            "description": "Per-principal quota reached"
          },
          "503": {
            "description": "Simulation capacity reached"
          },
          "504": {
            "description": "Simulation time budget exceeded"
          }
        }
      }
    },
    "/api/v1/episodes": {
      "post": {
        "operationId": "startPhysicsEpisode",
        "summary": "Start a bounded physical experiment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schemaVersion": {
                    "type": "integer",
                    "const": 1
                  },
                  "scenario": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "preset": {
                        "type": "string",
                        "enum": [
                          "winter",
                          "burst",
                          "summer",
                          "pump-fault"
                        ]
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "horizonMinutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 360
                      },
                      "outsideC": {
                        "type": "number",
                        "minimum": -20,
                        "maximum": 40
                      },
                      "loadFraction": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "occupants": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 200
                      },
                      "solarKW": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 30
                      },
                      "initialState": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "gpuC": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 120
                          },
                          "coolantC": {
                            "type": "number",
                            "minimum": 5,
                            "maximum": 70
                          },
                          "buildingC": {
                            "type": "number",
                            "minimum": 5,
                            "maximum": 40
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Episode created; initial observation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "episodeId",
                    "mode",
                    "minute",
                    "state",
                    "controls",
                    "done",
                    "hardwareAuthorized"
                  ],
                  "properties": {
                    "episodeId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "mode": {
                      "const": "simulation-only"
                    },
                    "minute": {
                      "type": "integer"
                    },
                    "state": {
                      "type": "object"
                    },
                    "controls": {
                      "type": "object"
                    },
                    "done": {
                      "type": "boolean"
                    },
                    "hardwareAuthorized": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid scenario"
          },
          "429": {
            "description": "Per-principal session quota reached"
          },
          "503": {
            "description": "Session capacity or storage unavailable"
          }
        }
      }
    },
    "/api/v1/episodes/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "observePhysicsEpisode",
        "summary": "Observe current simulated state",
        "responses": {
          "200": {
            "description": "Current observation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "episodeId",
                    "mode",
                    "minute",
                    "state",
                    "controls",
                    "done",
                    "hardwareAuthorized"
                  ],
                  "properties": {
                    "episodeId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "mode": {
                      "const": "simulation-only"
                    },
                    "minute": {
                      "type": "integer"
                    },
                    "state": {
                      "type": "object"
                    },
                    "controls": {
                      "type": "object"
                    },
                    "done": {
                      "type": "boolean"
                    },
                    "hardwareAuthorized": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Missing/expired episode"
          }
        }
      },
      "delete": {
        "operationId": "discardPhysicsEpisode",
        "summary": "Discard an in-memory episode",
        "responses": {
          "200": {
            "description": "Episode discarded"
          },
          "404": {
            "description": "Missing/expired episode"
          }
        }
      }
    },
    "/api/v1/episodes/{id}/step": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "stepPhysicsEpisode",
        "summary": "Apply a patch, advance simulation and observe",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expectedMinute"
                ],
                "properties": {
                  "expectedMinute": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 360
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 360
                  },
                  "controls": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "gpuPowerLimitPct": {
                        "type": "number",
                        "minimum": 40,
                        "maximum": 100
                      },
                      "pumpPct": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 100
                      },
                      "fanPct": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "heatRecoveryPct": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "heatingSetpointC": {
                        "type": "number",
                        "minimum": 16,
                        "maximum": 25
                      },
                      "ventilationACH": {
                        "type": "number",
                        "minimum": 0.2,
                        "maximum": 3
                      },
                      "lightingPct": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New observation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "episodeId",
                    "mode",
                    "minute",
                    "state",
                    "controls",
                    "done",
                    "hardwareAuthorized"
                  ],
                  "properties": {
                    "episodeId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "mode": {
                      "const": "simulation-only"
                    },
                    "minute": {
                      "type": "integer"
                    },
                    "state": {
                      "type": "object"
                    },
                    "controls": {
                      "type": "object"
                    },
                    "done": {
                      "type": "boolean"
                    },
                    "hardwareAuthorized": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid action or completed horizon"
          },
          "404": {
            "description": "Missing/expired episode"
          },
          "409": {
            "description": "Stale expectedMinute"
          }
        }
      }
    },
    "/api/v1/episodes/{id}/report": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getPhysicsEpisodeReport",
        "summary": "Export trace, control history and reproducible request",
        "responses": {
          "200": {
            "description": "Simulated episode report and replay request"
          },
          "404": {
            "description": "Missing/expired episode"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Mandatory for public services. Use a server-side secret, not browser JavaScript."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
